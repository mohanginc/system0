OPENAI_API_KEY=
# 기본 모델을 바꿀 때만 지정한다.
OPENAI_MODEL=gpt-6.1-sol
# 네이버 인증정보는 %LOCALAPPDATA%/system0/.env에 직접 입력한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 운영 DB는 OneDrive 밖에 생성된다. 경로를 바꿀 때만 지정한다.
# DATABASE_PATH=C:/Users/사용자/AppData/Local/system0/system0.sqlite
PORT=3000
# HTTPS 인증 프록시 뒤에서 운영할 때만 지정한다. 로그인은 프록시에서 별도로 설정한다.
# SYSTEM0_PUBLIC_ORIGIN=https://system0.babestellar.com

# 디스코드 설정은 scripts/configure-discord.ps1로 %LOCALAPPDATA%/system0/discord.env에 저장한다.
# 봇은 아래 지정한 서버·텍스트 채널·직원만 허용한다. ID 목록은 쉼표로 구분한다.
# DISCORD_BOT_TOKEN=
# DISCORD_API_SECRET=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_IDS=
# DISCORD_USER_IDS=
# DISCORD_API_BASE=http://127.0.0.1:3000
# DISCORD_NAVER_FILE_PASSWORD=

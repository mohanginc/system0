# 원본 주문 데이터와 생성 결과
/reference-data/
/outputs/

# 임시 작업 파일
/.work/
~$*

# 로컬 환경 설정 (.env.example은 공유)
.env
.env.*
!.env.example

# Python 가상환경과 캐시
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node.js 의존성과 로컬 검증 결과
node_modules/
.playwright-cli/

# 운영 데이터는 Git에 포함하지 않는다
*.sqlite
*.sqlite-*
*.db
*.db-*
